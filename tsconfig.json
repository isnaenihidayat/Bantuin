{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@bantuin/core": ["packages/core/src/index.ts"],
      "@bantuin/agent": ["packages/agent/src/index.ts"],
      "@bantuin/providers": ["packages/providers/src/index.ts"],
      "@bantuin/db": ["packages/db/src/index.ts"],
      "@bantuin/client": ["packages/client/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
