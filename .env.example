# Runtime defaults are safe for local development.
BANTUIN_HOST=127.0.0.1
BANTUIN_PORT=4310
BANTUIN_PUBLIC_ORIGIN=http://127.0.0.1:4310
DATABASE_URL=file:data/bantuin.sqlite
BANTUIN_PROVIDER=mock
BANTUIN_LIVE_PROVIDER_CHECK=false

# Required only when BANTUIN_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Bantuin

# CLI and channel clients. Use real values only in local env, never in Git.
BANTUIN_API_URL=http://127.0.0.1:4310
BANTUIN_EMAIL=
BANTUIN_PASSWORD=

# Telegram adapter. Private-text only; one allowlisted numeric user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
