{
  "name": "bantuin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:api",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "start": "bun apps/api/src/index.ts",
    "build": "bun build apps/api/src/index.ts --outdir dist/api --target bun --minify",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:secrets": "bun scripts/check-secrets.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:boundaries && bun run check:secrets && bun test && bun run build",
    "db:migrate": "bun packages/db/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
