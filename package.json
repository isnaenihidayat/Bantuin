{
  "name": "bantuin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun --cwd apps/web dev",
    "start": "bun apps/api/src/index.ts",
    "start:cli": "bun apps/cli/src/index.ts",
    "start:telegram": "bun apps/telegram/src/index.ts",
    "build": "bun run build:api && bun run build:web && bun run build:cli && bun run build:telegram",
    "build:api": "bun build apps/api/src/index.ts --outdir dist/api --target bun --minify",
    "build:web": "bun --cwd apps/web build",
    "build:cli": "bun --cwd apps/cli build",
    "build:telegram": "bun --cwd apps/telegram build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:secrets": "bun scripts/check-secrets.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:boundaries && bun run check:secrets && bun test && bun run build",
    "db:migrate": "bun packages/db/src/cli.ts",
    "db:backup": "bun scripts/database-backup.ts backup",
    "db:restore": "bun scripts/database-backup.ts restore"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
